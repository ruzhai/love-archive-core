# ============================================================
#  love-archive-core 配置
#  复制成 .env 再改。带 NEXT_PUBLIC_ 前缀的是**构建期**变量：
#  Docker 部署时要写进 docker-compose.yml 的 build.args，改完必须重新 build。
# ============================================================

# ---- 必填：登录会话的签名密钥 ----
# 生产环境缺这一项会启动即失败（不能用默认值，否则任何人都能自签管理员 token）。
# 生成一个：openssl rand -base64 48
JWT_SECRET=

# ---- 站点身份 ----
NEXT_PUBLIC_SITE_NAME=Love Archive
NEXT_PUBLIC_SITE_NAME_CN=恋爱档案馆
NEXT_PUBLIC_SITE_SUPERTITLE=Private Digital Archive
NEXT_PUBLIC_SITE_TAGLINE=我们的小宇宙，正在慢慢长大。
NEXT_PUBLIC_SITE_DESCRIPTION=这里收藏着我们相遇以来，那些没有被时间冲淡的小事。

# ---- 两个日期 ----
# startDate：故事起点，首页「已记录天数」用它
# relationshipDate：正式在一起的日子，「相伴天数」和纪念日倒数用它
NEXT_PUBLIC_START_DATE=2024-01-01
NEXT_PUBLIC_RELATIONSHIP_DATE=2024-02-14

# ---- 两位记录者的显示名 ----
# 只是显示名，随便改，不会动数据（数据库里存的是 author1 / author2）
NEXT_PUBLIC_AUTHOR1_NAME=我
NEXT_PUBLIC_AUTHOR1_EMOJI=🧑
NEXT_PUBLIC_AUTHOR2_NAME=你
NEXT_PUBLIC_AUTHOR2_EMOJI=👧

# ---- 首次启动的账号密码（可选）----
# 不填就自动生成随机密码并打印在启动日志里（只显示一次）。
# 值是 JSON，注意要整个用单引号包起来，否则 .env 解析器会在冒号处断掉。
ADMIN_PASSWORDS='{"author1":"你的密码","author2":"对方的密码"}'

# ---- 存储位置 ----
# 默认 ./love-archive.db。Docker 里指向挂载出来卷，否则重建容器就丢数据。
DATABASE_PATH=

# ---- 反代上了 HTTPS 之后改成 true ----
# 直接 http://IP:端口 访问时必须保持 false。保持 true 的话浏览器会丢掉带 Secure 的
# cookie，表现是「密码输对了但一直回到登录页」。
SECURE_COOKIES=false
